# ── Core ───────────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garden
# PICCOLO_CONF=piccolo_conf
STATELESS=false
DEBUG=false

# ── Storage backend ────────────────────────────────────────
# STORAGE_BACKEND=local          # "local" (default) or "s3"
# S3_BUCKET=my-media-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=               # custom endpoint for MinIO / Cloudflare R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=          # write-only — never echoed back in the admin UI
# S3_PREFIX=                     # optional key prefix, e.g. "uploads"
# S3_PUBLIC_URL=                 # direct URL base, e.g. https://cdn.example.com

# ── OAuth2 / OIDC ──────────────────────────────────────────
# OAUTH_PROVIDER_NAME=pocket-id
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ISSUER_URL=https://pocketid.example.com
# OAUTH_REDIRECT_URI=http://localhost:8000/admin/oauth/callback
# OAUTH_ALLOWED_GROUP=           # leave empty to admit ANY authenticated user (DANGEROUS)

# ── Observability (optional) ───────────────────────────────
# OTEL_RESOURCE_ATTRIBUTES="service.name=garden-cms,service.version=0.2.0"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
# OTEL_EXPORTER_OTLP_INSECURE="true"
# OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
# OTEL_METRICS_EXPORTER="none"