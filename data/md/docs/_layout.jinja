{# Docs page layout — theme-driven.

   The active theme (via render_themed) provides the page shell
   (header, footer, body styles). This layout emits *semantic,
   class-based* markup only — .doc-shell / .doc-nav / .doc-content —
   and carries no styling of its own. Each theme's CSS decides the
   arrangement: Nightshade renders .doc-nav as a left sidebar, while
   Mycelium and Sprig render it as a horizontal top nav. Swapping the
   active theme swaps the docs layout. #}
{% set docs_nav = [
    ("/docs",                       "Overview"),
    ("/docs/installation",          "Installation"),
    ("/docs/getting-started",       "Getting Started"),
    ("/docs/pages",                 "Pages"),
    ("/docs/content-blocks",        "Content Blocks"),
    ("/docs/collections",           "Collections"),
    ("/docs/themes",                "Themes"),
    ("/docs/media",                 "Media"),
    ("/docs/markdown-mounts",       "Markdown Mounts"),
    ("/docs/templates",             "Templates"),
    ("/docs/authentication",        "Authentication"),
    ("/docs/deployment",            "Deployment"),
    ("/docs/configuration",         "Configuration"),
] %}

<div class="doc-shell">
  <aside class="doc-nav" aria-label="Documentation sections">
    <a class="doc-nav__title" href="/docs">Documentation</a>
    <ul>
      {% for url, label in docs_nav %}
      <li><a href="{{ url }}" {% if current_path == url %}aria-current="page"{% endif %}>{{ label }}</a></li>
      {% endfor %}
    </ul>
  </aside>
  <article class="doc-content">
    <p class="doc-crumbs"><a href="/docs">Docs</a> &rsaquo; <strong>{{ title }}</strong></p>
    {{ content }}
  </article>
</div>
