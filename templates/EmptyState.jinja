{#def title, body="", cta_url="", cta_label="" #}
{#- Empty state block. Usage:
<EmptyState
  title="No pages yet"
  body="Pages are Jinja templates — the first one you create becomes the homepage."
  cta_url="/admin/pages/new"
  cta_label="Create your first page"
/>
-#}
<div class="empty-state">
  <h3>{{ title }}</h3>
  {% if body %}<p>{{ body }}</p>{% endif %}
  {% if cta_url and cta_label %}
  <div class="empty-state__actions">
    <a role="button" href="{{ cta_url }}">{{ cta_label }}</a>
  </div>
  {% endif %}
</div>