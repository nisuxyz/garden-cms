  "star": '<path d="M8 2 L9.8 6.5 L14.5 6.7 L10.8 9.5 L12.2 14 L8 11.3 L3.8 14 L5.2 9.5 L1.5 6.7 L6.2 6.5 Z" fill="currentColor"/>',
  "logout": '<path d="M6 3 H3 V13 H6 M9 5 L13 8 L9 11 M13 8 H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
