  "close": '<path d="M3 3 L13 13 M13 3 L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
} %}
<svg
  viewBox="0 0 16 16"
  width="{{ size }}"
  height="{{ size }}"
  aria-hidden="{{ "true" if not label else "false" }}"
  {% if label %}role="img"{% endif %}
  {% if label %}aria-label="{{ label }}"{% endif %}
>{% autoescape false %}{{ icons[name] or icons["page"] }}{% endautoescape %}</svg>