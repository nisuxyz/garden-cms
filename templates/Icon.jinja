  "settings": '<circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M8 1.5 V3.5 M8 12.5 V14.5 M1.5 8 H3.5 M12.5 8 H14.5 M3.5 3.5 L4.9 4.9 M11.1 11.1 L12.5 12.5 M12.5 3.5 L11.1 4.9 M4.9 11.1 L3.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
