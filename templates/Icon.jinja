  "collection": '<path d="M2 4 H14 M2 8 H14 M2 12 H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  "media": '<path d="M2 4 V12 H14 V4 Z M2 10 L5 7 L8 10 L11 6 L14 10 M10 6 a1 1 0 1 0 0.001 0" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>',
