{#def name, size=16, label="" #}
{#- Inline SVG icon. Usage:
<Icon name="up" />
<Icon name="trash" label="Delete page" />
Available names: up, down, trash, edit, plus, external, page, block, collection, media, theme, settings, doc, check, star, logout, menu, close
-#}
{% set name = name | lower %}
{% set icons = {
  "up": '<path d="M8 3 L13 10 L3 10 Z" fill="currentColor"/>',
  "down": '<path d="M8 13 L13 6 L3 6 Z" fill="currentColor"/>',
  "trash": '<path d="M3 4 H13 M5 4 V13 H11 V4 M7 1 H9 L10 3 H6 L7 1 Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  "edit": '<path d="M11 2 L14 5 L5 14 L2 14 L2 11 L11 2 Z M10 3 L13 6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>',
  "plus": '<path d="M8 3 V13 M3 8 H13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  "external": '<path d="M9 3 H13 V7 M13 3 L7 9 M11 9 V13 H3 V5 H7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  "page": '<path d="M3 2 H10 L13 5 V14 H3 Z M10 2 V5 H13 M5.5 8 H10.5 M5.5 11 H10.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>',
